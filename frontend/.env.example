# Where the API lives. No trailing slash after /api.
#
# Local dev points at `php artisan serve`; on Vercel this is set in the project
# settings (Settings -> Environment Variables) to the deployed backend, e.g.
#   https://verbo-api.up.railway.app/api
#
# Vite inlines VITE_* vars at BUILD time, so changing this in Vercel needs a
# redeploy to take effect — editing it does not update a build that already ran.
VITE_API_URL=http://127.0.0.1:8000/api

# Pusher Channels sends instant conversation-update signals. This key is safe
# in the browser; the Pusher secret stays only in backend/.env.
VITE_PUSHER_APP_KEY=
VITE_PUSHER_APP_CLUSTER=mt1

# Google sign-in. The OAuth 2.0 Web application CLIENT ID from
# https://console.cloud.google.com/apis/credentials — NOT the client secret,
# which this flow never uses. Public by design; it ships to the browser.
#
# Must be the SAME value as GOOGLE_CLIENT_ID in backend/.env, or the browser
# mints tokens for one audience while the server verifies another and every
# sign-in fails.
#
# Leave blank and the Google button simply does not render.
VITE_GOOGLE_CLIENT_ID=
