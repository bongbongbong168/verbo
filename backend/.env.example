APP_NAME=Verbo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

TESSERACT_PATH="C:/Program Files/Tesseract-OCR/tesseract.exe"

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

# Set to pusher in deployment after adding the Pusher Channels credentials
# below. The frontend receives only private update signals; Verbo's API still
# serves every message body and attachment.
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail — how verification and password-reset CODES reach people.
#
# Gmail SMTP. MAIL_PASSWORD is a Google APP PASSWORD (16 characters), never
# the account's real password: Google rejects the real one for SMTP, and an
# app password can be revoked on its own without changing your login.
# Create one at https://myaccount.google.com/apppasswords (needs 2-Step
# Verification turned on first).
#
# MAIL_FROM_ADDRESS must be the SAME Gmail address as MAIL_USERNAME — Gmail
# rewrites a mismatched sender, and some providers bounce the message.
#
# Leaving this as `log` or `array` is a supported state: EmailCodeService
# treats both as "no mailer" and the app says so plainly instead of pretending
# a code was sent. Nothing else breaks — sign-up still works, it just cannot
# confirm the address.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# PRODUCTION USES `brevo`, NOT `smtp`, AND THAT IS NOT A PREFERENCE.
# Railway blocks every outbound SMTP port — measured from inside the running
# container, 25/465/587 all time out while 443 is open — so mail has to leave
# over HTTPS. Set MAIL_MAILER=brevo there and give it the key below; a laptop
# keeps the smtp settings above, where they work.
#
# The key comes from Brevo -> SMTP & API -> API Keys. MAIL_FROM_ADDRESS must
# be an address verified as a sender in that Brevo account, or it refuses the
# message. Brevo verifies a single address by emailed code, with no DNS
# domain ownership needed, which is why it was chosen — Verbo has no domain.
BREVO_API_KEY=
# BREVO_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Stripe. Test keys from https://dashboard.stripe.com/test/apikeys
# STRIPE_WEBHOOK_SECRET is printed by `stripe listen` when running locally.
# Payments stay in demo mode (nothing charged) while these are empty.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# --- Deployment ---------------------------------------------------------
# Set on the host (Railway), not committed. Left blank here so a fresh local
# checkout keeps working unchanged.
#
# APP_URL must match the address the API is actually served from — Storage::url()
# builds absolute image URLs from it, so a mismatch means every uploaded picture
# 404s even though the API itself answers fine.
# APP_URL=https://verbo-api.up.railway.app

# The deployed frontend's origin, added to the CORS allow-list. FRONTEND_URLS
# takes a comma-separated list for extra origins; FRONTEND_URL_PATTERN takes a
# regex, which is what Vercel's per-branch preview URLs need.
# FRONTEND_URL=https://verbo.vercel.app
# FRONTEND_URLS=
# FRONTEND_URL_PATTERN=

# Where the mounted volume is. The SQLite file and every upload live here so
# they survive a redeploy.
# VERBO_DATA_DIR=/data
# DB_DATABASE=/data/database.sqlite

# --- Supabase Postgres -------------------------------------------------
# The image already carries pdo_pgsql, so switching is env only — no rebuild.
# Details: Supabase dashboard -> Project Settings -> Database.
#
# Use the SESSION POOLER host (port 5432). The transaction pooler on 6543
# does not support prepared statements, which Laravel relies on.
# DB_CONNECTION=pgsql
# DB_HOST=aws-0-<region>.pooler.supabase.com
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=
#
# Supabase requires TLS. The default "prefer" falls back to an unencrypted
# connection without complaining, so pin it.
# DB_SSLMODE=require
#
# Needed ONLY while running `php artisan db:copy`: it keeps the old SQLite
# file readable as the SOURCE while DB_DATABASE names the Postgres target.
# Both connections used to read DB_DATABASE, so without this the copy has
# no source to read from.
# DB_SQLITE_DATABASE=/data/database.sqlite

# Google sign-in. The same OAuth 2.0 Web application client id the frontend
# uses as VITE_GOOGLE_CLIENT_ID — the server needs it to check the `aud` claim
# on the ID token the browser sends. There is deliberately no client secret:
# verifying an ID token does not require one.
GOOGLE_CLIENT_ID=

# Google Safe Browsing. Checks links posted in messages, article comments,
# tutor reviews and tutor profiles (bio + intro video).
#
# A plain API key from the Google Cloud console with the Safe Browsing API
# enabled. SERVER-SIDE ONLY — unlike GOOGLE_CLIENT_ID above, this is a secret
# and must never get a VITE_ twin.
#
# Leave it empty and link checking is simply off; nothing else changes. When it
# is set and the API cannot be reached, content is still allowed through and
# the failure is logged — see SafeBrowsingService for why that is deliberate.
GOOGLE_SAFE_BROWSING_KEY=
# How long a URL that came back clean is trusted, in seconds. Hours, not days:
# a URL clean today can be flagged tomorrow.
SAFE_BROWSING_CLEAN_TTL=3600
# Seconds to wait on Google before giving up and letting the content through.
SAFE_BROWSING_TIMEOUT=4

# The floating Chinese practice assistant (Gemini).
#
# SERVER-SIDE ONLY — never give this a VITE_ twin. The browser talks to
# Laravel and Laravel talks to Google, so the key is never shipped to the
# client and cannot be spent by whoever reads the bundle.
#
# Free key: https://aistudio.google.com -> Get API key -> Create API key.
# Leave it blank and the assistant button simply does not render.
GEMINI_API_KEY=

# DeepL API Free. Server only; never use a VITE_ prefix.
DEEPL_API_KEY=

# Deepgram transcribes Mandarin and returns word timings. Verbo adds pinyin
# and uses DeepL above for English translation. Server only — no VITE_ prefix.
DEEPGRAM_API_KEY=
# DEEPGRAM_MODEL=nova-3
# DEEPGRAM_TIMEOUT=120

# Optional. Defaults to the free tier's fast model.
# GEMINI_MODEL=gemini-3-flash-preview
