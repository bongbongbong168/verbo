<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="./vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory suffix="Test.php">./tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory suffix="Test.php">./tests/Feature</directory>
        </testsuite>
    </testsuites>
    <coverage processUncoveredFiles="true">
        <include>
            <directory suffix=".php">./app</directory>
        </include>
    </coverage>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="CACHE_DRIVER" value="array"/>
        <!-- Tests must never reach the real Pusher app. -->
        <env name="BROADCAST_DRIVER" value="null"/>
        <!-- NEVER COMMENT THESE OUT. Without them the suite inherits DB_DATABASE
             from .env, which is database/database.sqlite — the real development
             database — and any test using RefreshDatabase runs `migrate:fresh`
             against it, dropping every table. That has happened once already and
             cost the local library and every account, booking and message on this
             machine; it was recovered from backups/ plus database/content.

             `:memory:` is thrown away when the process ends, so a test run cannot
             touch development data no matter what it does. -->
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- No real provider keys in tests: a test that forgets Http::fake must
             fail, not quietly spend quota on a real Google/DeepL call. Tests
             that need a key set a fake one with config(). -->
        <env name="GEMINI_API_KEY" value=""/>
        <env name="DEEPL_API_KEY" value=""/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
    </php>
</phpunit>
